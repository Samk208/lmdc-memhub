{
    "name": "lnmc/member-hub",
    "description": "A comprehensive member management system for LNMC with REST API endpoints and admin settings",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "LNMC Development Team",
            "email": "dev@lnmc.org"
        }
    ],
    "require": {
        "php": ">=8.1",
        "stripe/stripe-php": "^14.11@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^3.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "LNMC_Member_Hub\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LNMC_Member_Hub\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpcs": "phpcs --standard=WordPress src/ tests/",
        "phpcbf": "phpcbf --standard=WordPress src/ tests/",
        "test:coverage": "phpunit --coverage-html coverage"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
